rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{userId}/profiles/{profileId} {
   allow read, write: if request.auth != null && request.auth.uid == userId;
   match /{subcollection}/{documentId} {
    allow read, write: if request.auth != null && request.auth.uid == userId && subcollection in ['dailyLogs','exerciseLogs','goals','weeklyReviews','monthlyReviews','quarterlyReviews','settingsHistory','milestones'];
   }
  }
 }
}
